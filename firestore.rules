rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- BLOG ---
    // Lectura pública solo de posts publicados; escritura únicamente vía Admin SDK.
    match /blog_posts/{slug} {
      allow read: if resource.data.status == 'published';
      allow write: if false;
    }

    // --- RIDES ---
    match /rides/{rideId} {
      // Un conductor activo puede leer las carreras (para el tablero)
      // O un pasajero puede leer sus propias carreras
      allow read: if request.auth != null && (
        (exists(/databases/$(database)/documents/drivers/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.status == 'active')
        ||
        ( 'client_uid' in resource.data && resource.data.client_uid == request.auth.uid )
      );

      // Solo el sistema (Server Actions) puede crear rides
      allow create: if false;

      // El conductor asignado (valor existente) solo puede cambiar estado y ubicación
      // en transiciones válidas; el pasajero solo puede cancelar su carrera OPEN.
      allow update: if request.auth != null && (
        (resource.data.driver_id == request.auth.uid &&
         request.resource.data.driver_id == resource.data.driver_id &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'driver_location', 'started_at', 'completed_at', 'cancelled_at', 'cancelled_by', 'cancellation_reason']) &&
         (
           !('status' in request.resource.data.diff(resource.data).affectedKeys()) ||
           (resource.data.status in ['ACCEPTED', 'IN_PROGRESS'] &&
            request.resource.data.status in ['IN_PROGRESS', 'COMPLETED', 'CANCELLED'])
         ))
        ||
        (resource.data.client_uid == request.auth.uid &&
         resource.data.status == 'OPEN' &&
         request.resource.data.status == 'CANCELLED' &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'cancelled_at', 'cancelled_by', 'cancellation_reason']))
      );

      allow delete: if false;
    }

    // --- DRIVERS ---
    match /drivers/{driverId} {
      // El conductor solo puede leer su propio perfil (los admins usan el Admin SDK)
      allow read: if request.auth != null && request.auth.uid == driverId;

      // El registro lo hace el Admin SDK (Server Action), por tanto:
      allow create: if false;

      // El conductor solo puede editar campos de contacto y disponibilidad; nunca
      // status, wallet_balance, user_id ni métricas (los gestiona el servidor).
      allow update: if request.auth != null
        && request.auth.uid == driverId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['availability', 'phone', 'whatsapp', 'photo_url', 'vehicle_description', 'updated_at']);

      allow delete: if false;
    }

    // --- WALLET TRANSACTIONS ---
    match /wallet_transactions/{transactionId} {
      // El conductor puede leer su propio historial de transacciones
      allow read: if request.auth != null && resource.data.driver_id == request.auth.uid;

      // Solo el Admin SDK (Server Action) o Functions pueden crearlas y mutarlas
      allow create, update, delete: if false;
    }

    // Default: Deny todo lo demás
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
